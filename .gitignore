# Pub workspace: resolution artifacts are shared at the workspace root.
.dart_tool/

# `flutter test <pkg> …` run from the workspace root writes its dill cache and
# unit-test assets here, not into the package's own `build/`. Each package
# ignores its own (see `app/.gitignore`); nothing ignored the root one, so a
# single test run left ~50 MB untracked — and `mold pack` put it in
# `template.g.dart`, taking the shipped archive from 460 KB to 22 MB.
/build/

# VS Code extension (tools/vscode) build artifacts.
*.vsix
node_modules/

# `make dist` — a native frx binary for this machine. The released ones are built
# by .github/workflows/release.yml, one runner per platform.
/tools/dist/

# Agent tooling: the committed parts (skills) ship with a clone; only the
# per-machine settings stay out. Ignoring the whole `.claude` directory meant a
# skill placed there reached nobody, and this is a template people clone.
.claude/settings.local.json

# Miscellaneous
.DS_Store
*.log

# Compiled output of the VSCode extension (built by `npm run compile`).
tools/vscode/out/
