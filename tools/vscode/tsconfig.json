{
  // The extension is CommonJS (VSCode loads it with `require`), so `module` is
  // node16 against a package.json with no `"type"`. TS wraps `import * as x` in
  // `__importStar`; that is safe for the mutable `vscode` stub the tests swap in
  // (test/helpers.ts) because __createBinding installs live getters onto the
  // wrapper rather than copying values — verified, not assumed.
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "node16",
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "out",
    "strict": true,
    // No linter runs here — typescript-eslint does not yet support the
    // TypeScript this builds with — so what a lint would catch cheaply is
    // asked of the compiler: an import or a parameter nothing reads.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vscode"]
  },
  "include": ["extension.ts", "validate-manifest.ts", "src/**/*.ts", "test/**/*.ts"],
  // The FRX Map's page script runs in a browser, not in Node, and is its own
  // project (tsconfig.page.json). `src/page/picture.d.ts` still enters here
  // through `src/map.ts`'s import — the one contract, read from both sides.
  "exclude": ["src/page"]
}
