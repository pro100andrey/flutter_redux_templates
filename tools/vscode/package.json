{
  "name": "frx",
  "displayName": "FRX — Flutter Redux Scaffolder",
  "description": "Scaffold AsyncRedux substates and auto_route pages via the frx CLI, with a build_runner watch toggle.",
  "version": "0.3.0",
  "publisher": "pro100dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0E1425",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pro100andrey/flutter_redux_templates.git",
    "directory": "tools/vscode"
  },
  "homepage": "https://github.com/pro100andrey/flutter_redux_templates/tree/main/tools/vscode#readme",
  "bugs": {
    "url": "https://github.com/pro100andrey/flutter_redux_templates/issues"
  },
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Visualization"
  ],
  "keywords": [
    "flutter",
    "dart",
    "async_redux",
    "auto_route",
    "scaffold"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "FRX runs the `frx` CLI and `build_runner` against the open folder, both of which write source files — nothing to offer a workspace you have not trusted."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "FRX spawns a local process against real paths; a virtual filesystem has none to give it."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "frx.addSubstate",
        "title": "Add Substate…",
        "category": "FRX"
      },
      {
        "command": "frx.addPage",
        "title": "Add Page…",
        "category": "FRX"
      },
      {
        "command": "frx.addTabs",
        "title": "Add Tabs…",
        "category": "FRX"
      },
      {
        "command": "frx.addAction",
        "title": "Add Action…",
        "category": "FRX",
        "icon": "$(zap)"
      },
      {
        "command": "frx.addNav",
        "title": "Wire navigation…",
        "category": "FRX",
        "icon": "$(arrow-right)"
      },
      {
        "command": "frx.addWidget",
        "title": "Add Widget…",
        "category": "FRX"
      },
      {
        "command": "frx.addConnector",
        "title": "Add Connector…",
        "category": "FRX"
      },
      {
        "command": "frx.addModel",
        "title": "Add Model…",
        "category": "FRX"
      },
      {
        "command": "frx.addEnum",
        "title": "Add Enum…",
        "category": "FRX"
      },
      {
        "command": "frx.addService",
        "title": "Add Service…",
        "category": "FRX"
      },
      {
        "command": "frx.addRetrofit",
        "title": "Add Retrofit Client…",
        "category": "FRX"
      },
      {
        "command": "frx.addThemeExtension",
        "title": "Add Theme Extension…",
        "category": "FRX"
      },
      {
        "command": "frx.addPackage",
        "title": "Add Package…",
        "category": "FRX"
      },
      {
        "command": "frx.addField",
        "title": "Add field…",
        "category": "FRX",
        "icon": "$(add)"
      },
      {
        "command": "frx.addSelector",
        "title": "Add selector…",
        "category": "FRX",
        "icon": "$(filter)"
      },
      {
        "command": "frx.rename",
        "title": "Rename…",
        "category": "FRX",
        "icon": "$(edit)"
      },
      {
        "command": "frx.remove",
        "title": "Remove…",
        "category": "FRX",
        "icon": "$(trash)"
      },
      {
        "command": "frx.planApply",
        "title": "Apply",
        "category": "FRX",
        "icon": "$(check)"
      },
      {
        "command": "frx.planDiscard",
        "title": "Discard",
        "category": "FRX",
        "icon": "$(close)"
      },
      {
        "command": "frx.planShow",
        "title": "Show the pending plan",
        "category": "FRX",
        "icon": "$(eye)"
      },
      {
        "command": "frx.map",
        "title": "Map",
        "category": "FRX",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "frx.flow",
        "title": "Flow…",
        "category": "FRX",
        "icon": "$(git-merge)"
      },
      {
        "command": "frx.routes",
        "title": "Navigation map",
        "category": "FRX",
        "icon": "$(milestone)"
      },
      {
        "command": "frx.doctor",
        "title": "Doctor",
        "category": "FRX"
      },
      {
        "command": "frx.doctorFix",
        "title": "Doctor — fix",
        "category": "FRX"
      },
      {
        "command": "frx.toggleWatch",
        "title": "Toggle build_runner watch",
        "category": "FRX"
      },
      {
        "command": "frx.showWatchOutput",
        "title": "Show watch output",
        "category": "FRX"
      },
      {
        "command": "frx.menu",
        "title": "Actions…",
        "category": "FRX"
      },
      {
        "command": "frx.refreshTree",
        "title": "Refresh",
        "category": "FRX",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "frx.menu",
        "key": "ctrl+alt+f",
        "when": "frx.isMonorepo"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "frx.tree",
          "name": "FRX",
          "when": "frx.isMonorepo"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "frx.addSubstate",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addPage",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addTabs",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addAction",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addNav",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addWidget",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addConnector",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addModel",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addEnum",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addService",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addRetrofit",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addThemeExtension",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addPackage",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addField",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.addSelector",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.rename",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.remove",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.planApply",
          "when": "false"
        },
        {
          "command": "frx.planDiscard",
          "when": "false"
        },
        {
          "command": "frx.planShow",
          "when": "false"
        },
        {
          "command": "frx.map",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.flow",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.routes",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.doctor",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.doctorFix",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.toggleWatch",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.showWatchOutput",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.menu",
          "when": "frx.isMonorepo"
        },
        {
          "command": "frx.refreshTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "frx.map",
          "when": "view == frx.tree",
          "group": "navigation@1"
        },
        {
          "command": "frx.routes",
          "when": "view == frx.tree",
          "group": "navigation@2"
        },
        {
          "command": "frx.refreshTree",
          "when": "view == frx.tree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "frx.addAction",
          "when": "view == frx.tree && viewItem == frxSubstate",
          "group": "inline"
        },
        {
          "command": "frx.rename",
          "when": "view == frx.tree && (viewItem == frxSubstate || viewItem == frxRoute)",
          "group": "inline@1"
        },
        {
          "command": "frx.remove",
          "when": "view == frx.tree && (viewItem == frxSubstate || viewItem == frxRoute)",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "frx.rename",
          "when": "frx.isMonorepo && editorLangId == dart",
          "group": "1_modification"
        }
      ],
      "editor/title": [
        {
          "command": "frx.planApply",
          "when": "frx.planTabActive",
          "group": "navigation@1"
        },
        {
          "command": "frx.planDiscard",
          "when": "frx.planTabActive",
          "group": "navigation@2"
        },
        {
          "command": "frx.routes",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && frx.isMonorepo && !frx.planTabActive",
          "group": "navigation@3"
        },
        {
          "command": "frx.flow",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && frx.isMonorepo && !frx.planTabActive",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "FRX",
      "properties": {
        "frx.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit path to the `frx` executable. Leave empty to auto-resolve: first `frx` on PATH, then `dart run` against the monorepo's `tools/` package."
        },
        "frx.runBuildRunner": {
          "type": "string",
          "enum": [
            "always",
            "ask",
            "never"
          ],
          "default": "ask",
          "markdownEnumDescriptions": [
            "Run `build_runner` automatically after scaffolding.",
            "Offer a button to run `build_runner` after scaffolding.",
            "Never run `build_runner`; do it yourself."
          ],
          "markdownDescription": "Whether to generate code (freezed part, auto_route class) after scaffolding a substate or page. Ignored while the `build_runner watch` toggle is running — the watch regenerates on save."
        },
        "frx.editorRename": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let **F2** on a substate/page symbol (its state class, `Select…`, route, connector, or field) rename the whole artifact via `frx rename`. Turn off to always use the Dart extension's plain rename; the **FRX: Rename…** command still works either way."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "typecheck": "tsc -p . --noEmit",
    "pretest": "rm -rf out && npm run compile",
    "test": "node --test out/test/*.test.js",
    "validate": "npm run compile && node out/validate-manifest.js",
    "vscode:prepublish": "npm run compile",
    "icon": "rsvg-convert -w 128 -h 128 media/icon.svg -o media/icon.png",
    "package": "vsce package",
    "install:vsix": "node -e \"const v=require('./package.json').version;require('child_process').execFileSync('code',['--install-extension','frx-'+v+'.vsix','--force'],{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/vscode": "1.120.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  }
}
